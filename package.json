{
  "name": "monopix",
  "version": "1.0.1",
  "description": "Pixel-art avatar generator based on name initials with multi-mode support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "avatar",
    "avatar-generator",
    "pixel",
    "pixel-art",
    "identicon",
    "initials",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watheek-div/monopix.git"
  },
  "bugs": {
    "url": "https://github.com/watheek-div/monopix/issues"
  },
  "homepage": "https://github.com/watheek-div/monopix#readme",
  "author": "watheek-div",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
